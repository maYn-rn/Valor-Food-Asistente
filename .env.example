# Generación con LLM. Puedes usar OpenAI o Groq.
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Embeddings locales por defecto: no requieren API key ni cuota.
# La primera ejecución puede descargar el modelo y luego queda en caché.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Si quieres volver a embeddings OpenAI, usa:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

TOP_K=3
MIN_SIMILARITY=0.25

# Opcional: trazabilidad LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=valor-food-asistente

# Búsqueda web global de respaldo: se usa solo si las fuentes internas no bastan.
# No necesita API key adicional; requiere conexión a Internet.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_REGION=cl-es
WEB_SEARCH_BACKEND=auto
